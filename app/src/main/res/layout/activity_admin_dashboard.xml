<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- HEADER -->
    <View
        android:id="@+id/backgroundHeader"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/bg_gradient_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#3310B981"
                app:cardBackgroundColor="#161E2E">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_canteen_logo" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNICANTEEN CONTROL"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:letterSpacing="0.14"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Admin Control Center"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>
        </LinearLayout>

        <!-- QUICK ACTIONS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_subtle"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Management Modules"
                    android:textColor="@color/text_main"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="20dp" />

                <!-- VIEW ORDERS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminOrders"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:text="Manage Live Orders"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/primary_blue"
                    app:icon="@drawable/ic_cart_shopping"
                    app:iconTint="@color/primary_blue"
                    app:iconSize="26dp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="@color/primary_blue_light" />

                <!-- MANAGE ITEMS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminItems"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="16dp"
                    android:text="Manage Menu Catalog"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/primary_blue"
                    app:icon="@drawable/ic_food_item"
                    app:iconTint="@color/primary_blue"
                    app:iconSize="26dp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="@color/primary_blue_light" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- LOGOUT -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminLogout"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Secure Admin Sign Out"
            android:textSize="15sp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/error_red"
            app:backgroundTint="@color/error_red_bg"
            app:cornerRadius="16dp" />

    </LinearLayout>

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/paymentHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_header"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP 2 OF 3 • PAYMENT METHOD"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Payment Method"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:fontFamily="sans-serif-black" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/paymentHeader"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select payment option"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_subtle"
            app:cardBackgroundColor="@color/bg_card">

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/rbCOD"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Cash on Delivery (Pay at Canteen Counter)"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:buttonTint="@color/primary_blue"
                    android:textColor="@color/text_main" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_subtle"
                    android:layout_marginHorizontal="12dp"/>

                <RadioButton
                    android:id="@+id/rbUPI"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="UPI / Instant Digital Payment"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:buttonTint="@color/primary_blue"
                    android:textColor="@color/text_main" />
            </RadioGroup>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="20dp"
        android:background="@color/bg_light">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue to Order Summary"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:fontFamily="sans-serif-bold"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/primary_blue"
            app:elevation="4dp" />
    </LinearLayout>

</RelativeLayout>